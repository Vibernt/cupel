{
  "spec": "cupel-spec/1",
  "kind": "input",
  "runtime": {
    "name": "node",
    "version": "22.23.3"
  },
  "runtimes": [
    {
      "runner": "node",
      "name": "node",
      "version": "22.23.3"
    },
    {
      "runner": "cargo",
      "name": "rust",
      "version": "1.94.1"
    }
  ],
  "sources": {
    "src/a.mjs": {
      "coverable": "1-10"
    },
    "src/b.rs": {
      "coverable": "1-10"
    }
  },
  "tests": [
    {
      "id": "a",
      "file": "tests/a.test.mjs",
      "name": "a",
      "status": "passed",
      "runner": "node"
    },
    {
      "id": "b",
      "file": "tests/b.rs",
      "name": "b",
      "status": "passed",
      "runner": "cargo"
    },
    {
      "id": "c",
      "file": "tests/c.test.mjs",
      "name": "c",
      "status": "passed",
      "runner": "node"
    }
  ],
  "coverage": {
    "granularity": "test",
    "byTest": {
      "a": {
        "src/a.mjs": "1-3"
      },
      "b": {
        "src/b.rs": "1-3"
      },
      "c": {
        "src/a.mjs": "5"
      }
    }
  },
  "mutation": {
    "targeted": [
      "a",
      "b",
      "c"
    ],
    "mutants": [
      {
        "id": "m1",
        "source": "src/a.mjs",
        "line": 2,
        "operator": "flip",
        "status": "killed",
        "killedBy": [
          "a",
          "b"
        ]
      },
      {
        "id": "m2",
        "source": "src/a.mjs",
        "line": 5,
        "operator": "flip",
        "status": "killed",
        "killedBy": [
          "c"
        ]
      }
    ]
  }
}
