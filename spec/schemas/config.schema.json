{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cupel.dev/schemas/cupel-spec-1/config.schema.json",
  "title": "Cupel config, cupel.json (cupel-spec/1)",
  "description": "Every key is optional. Defaults are given as `default` and apply when a key is absent.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "spec": { "type": "string", "pattern": "^cupel-spec/1(\\.[0-9]+)?$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "type": "array", "items": { "type": "string" }, "default": ["**"] },
        "exclude": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "runners": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "tests": { "type": "string" },
          "collector": { "type": "string", "description": "An external collector command that writes the input format (D13)." },
          "prepare": { "type": "string", "description": "A command run once before collecting, for example a build step." },
          "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Extra environment variables for the test run." }
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "array", "items": { "type": "string" }, "default": [] },
        "minor": { "type": "array", "items": { "type": "string" }, "default": [] },
        "pathWords": {
          "type": "array", "items": { "type": "string", "minLength": 1 },
          "default": ["auth", "permission", "tenan", "token", "secret", "egress", "billing", "quota", "migrat", "backup", "delet", "public-api", "credential", "crypto", "leak", "unsafe", "sign-in", "login", "security", "isolat", "sandbox", "privacy", "integrity", "redact", "inject", "travers", "harden", "admission", "budget"]
        },
        "titleWords": {
          "type": "array", "items": { "type": "string", "minLength": 1 },
          "default": ["negative", "security", "forged", "tamper", "refuse", "permission", "token", "secret", "credential", "unsafe", "leak"]
        },
        "extraPathWords": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
        "extraTitleWords": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "boolean", "default": true },
        "changedLines": { "type": "boolean", "default": true },
        "targeted": { "type": "boolean", "default": true, "description": "Mutate the own lines of retire candidates (D5)." },
        "maxMutants": { "type": "integer", "minimum": 1, "default": 200 },
        "maxSeconds": { "type": "integer", "minimum": 1, "default": 300 },
        "seed": { "type": "integer", "default": 20261021 }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage": { "const": "ratchet", "default": "ratchet" },
        "criticalCoverage": {
          "anyOf": [{ "const": "ratchet" }, { "type": "number", "minimum": 0, "maximum": 100 }],
          "default": "ratchet"
        },
        "criticalMutation": { "const": "no-loss", "default": "no-loss" }
      }
    },
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consolidate": { "type": "boolean", "default": true },
        "shapeSimilarity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 },
        "lineJaccard": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.3 },
        "duplicateShape": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.9 },
        "slowMs": { "type": "integer", "minimum": 0, "default": 2000 },
        "lowValueUniqueLines": { "type": "integer", "minimum": 0, "default": 5 },
        "minRuns": { "type": "integer", "minimum": 1, "default": 2 }
      }
    },
    "brittleness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patterns": {
          "type": "array",
          "description": "Extra detector patterns, as data (D13). Collectors apply them; the engine reads only the resulting findings.",
          "items": {
            "type": "object",
            "required": ["kind", "pattern"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["source-text", "css-class", "doc-wording", "file-snapshot"] },
              "language": { "type": "string" },
              "pattern": { "type": "string", "minLength": 1 },
              "deliberate": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
