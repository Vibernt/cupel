{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cupel.dev/schemas/cupel-spec-1/report.schema.json",
  "title": "Cupel report (cupel-spec/1)",
  "description": "The engine's output for every command. Keys appear in the order listed here (R1). After exit 2 or 3 only spec, kind, command and diagnostics are present.",
  "type": "object",
  "required": ["spec", "kind", "command", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "spec": { "type": "string", "pattern": "^cupel-spec/1(\\.[0-9]+)?$" },
    "kind": { "const": "report" },
    "command": { "enum": ["report", "plan", "check", "guard", "label", "validate", "review", "audit"] },
    "generatedAt": { "type": "string" },
    "runtime": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runner", "name", "version"],
        "additionalProperties": false,
        "properties": { "runner": { "type": "string" }, "name": { "type": "string" }, "version": { "type": "string" } }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["error", "warning"] },
          "path": { "type": "string" },
          "test": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "suite": {
      "type": "object",
      "required": ["tests", "units", "passed", "failed", "skipped", "durationMs", "coverage", "criticalCoverage", "mutation", "criticalMutation", "advice"],
      "additionalProperties": false,
      "properties": {
        "tests": { "type": "integer", "minimum": 0 },
        "units": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "coverage": { "$ref": "#/$defs/coverageRatio" },
        "unmeasured": { "type": "integer", "minimum": 1, "description": "Sources the collector could not measure (R3); absent when there are none." },
        "criticalCoverage": { "$ref": "#/$defs/coverageRatio" },
        "mutation": { "anyOf": [{ "$ref": "#/$defs/mutationScore" }, { "type": "null" }] },
        "criticalMutation": { "anyOf": [{ "$ref": "#/$defs/mutationScore" }, { "type": "null" }] },
        "advice": {
          "type": "object",
          "required": ["keep", "consolidate", "rewrite", "move-to-check", "none"],
          "additionalProperties": false,
          "properties": {
            "keep": { "type": "integer", "minimum": 0 },
            "consolidate": { "type": "integer", "minimum": 0 },
            "rewrite": { "type": "integer", "minimum": 0 },
            "move-to-check": { "type": "integer", "minimum": 0 },
            "none": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "rows", "tier", "tierReason", "protected", "status", "signals", "advice", "reasons", "hints"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "rows": { "type": "array", "items": { "type": "string" } },
          "tier": { "$ref": "#/$defs/tier" },
          "tierReason": { "enum": ["tag", "path-rule", "critical-word", "unique-critical-lines", "default"] },
          "protected": { "type": "boolean" },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "signals": {
            "type": "object",
            "required": ["ownLines", "uniqueLines", "kills", "uniqueKills", "durationMs", "runs", "brittle"],
            "additionalProperties": false,
            "properties": {
              "ownLines": { "type": "integer", "minimum": 0 },
              "uniqueLines": { "type": ["integer", "null"], "minimum": 0 },
              "kills": { "type": "integer", "minimum": 0 },
              "uniqueKills": { "type": ["integer", "null"], "minimum": 0 },
              "durationMs": { "type": "integer", "minimum": 0 },
              "runs": { "type": "integer", "minimum": 0 },
              "brittle": { "type": "array", "items": { "$ref": "#/$defs/brittleKind" } }
            }
          },
          "advice": { "$ref": "#/$defs/advice" },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "hints": { "type": "array", "items": { "type": "string" } },
          "group": { "type": "string" },
          "duplicateOf": { "type": "string" }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "file", "units"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^g[1-9][0-9]*$" },
          "kind": { "const": "same-shape" },
          "file": { "type": "string" },
          "units": { "type": "array", "minItems": 2, "items": { "type": "string" } }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "uniqueLines", "hints"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string" },
          "uniqueLines": { "type": "integer", "minimum": 0 },
          "hints": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": ["mode", "order", "skipped", "expectedMs"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["full", "changed"] },
        "order": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "bucket", "durationMs"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "bucket": { "enum": ["critical", "affected", "standard", "rest", "minor"] },
              "durationMs": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "skipped": { "type": "array", "items": { "type": "string" } },
        "expectedMs": { "type": "integer", "minimum": 0 }
      }
    },
    "check": {
      "type": "object",
      "required": ["verdicts"],
      "additionalProperties": false,
      "properties": {
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "verdict", "brittle"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "verdict": { "enum": ["adds-value", "no-unique-evidence", "weakens", "fails", "not-run"] },
              "extend": { "type": ["string", "null"] },
              "brittle": { "type": "array", "items": { "$ref": "#/$defs/brittleKind" } },
              "lost": { "$ref": "#/$defs/lost" }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["notice", "candidates", "critical"],
      "additionalProperties": false,
      "properties": {
        "notice": { "const": "No unique evidence is not proof that a test is redundant. Read each candidate's assertions; a proposed removal or merge must pass guard before it is committed. Cupel never advises removal." },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["unit", "file", "tier", "tierReason", "status", "reasons", "evidence", "guardRequired"],
            "additionalProperties": false,
            "properties": {
              "unit": { "type": "string" },
              "file": { "type": "string" },
              "tier": { "$ref": "#/$defs/tier" },
              "tierReason": { "enum": ["tag", "path-rule", "critical-word", "unique-critical-lines", "default"] },
              "status": { "enum": ["passed", "failed", "skipped"] },
              "reasons": { "type": "array", "minItems": 1, "items": { "enum": ["same-shape-group", "no-unique-evidence", "brittle", "pseudo-test", "never-passes"] } },
              "evidence": {
                "type": "object",
                "required": ["ownLines", "uniqueLines", "kills", "uniqueKills", "overlaps", "group", "brittle"],
                "additionalProperties": false,
                "properties": {
                  "ownLines": { "type": "object", "additionalProperties": { "$ref": "#/$defs/lineSet" } },
                  "uniqueLines": { "anyOf": [{ "type": "object", "additionalProperties": { "$ref": "#/$defs/lineSet" } }, { "type": "null" }] },
                  "kills": { "type": "integer", "minimum": 0 },
                  "uniqueKills": { "type": ["integer", "null"], "minimum": 0 },
                  "overlaps": {
                    "type": "array", "maxItems": 5,
                    "items": {
                      "type": "object", "required": ["unit", "sharedLines", "sharedKills", "coversAllOf"], "additionalProperties": false,
                      "properties": { "unit": { "type": "string" }, "sharedLines": { "type": "integer", "minimum": 0 }, "sharedKills": { "type": "integer", "minimum": 0 }, "coversAllOf": { "type": "boolean" } }
                    }
                  },
                  "group": { "anyOf": [{ "type": "object", "required": ["id", "members"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "members": { "type": "array", "items": { "type": "string" } } } }, { "type": "null" }] },
                  "brittle": { "type": "array", "items": { "$ref": "#/$defs/brittleKind" } },
                  "pseudoTestedFunctions": { "type": "array", "items": { "type": "string" } },
                  "assertions": { "type": "object", "required": ["assertionCount", "fingerprints", "uniqueFingerprints", "incomplete", "capHit", "assertionFree", "subsumedBy", "cloneOf"], "additionalProperties": false,
                    "properties": {
                      "assertionCount": { "type": "integer", "minimum": 0 },
                      "fingerprints": { "type": "array", "items": { "type": "string" } },
                      "uniqueFingerprints": { "type": "array", "items": { "type": "string" } },
                      "incomplete": { "type": "boolean" },
                      "capHit": { "type": "boolean" },
                      "assertionFree": { "type": ["boolean", "null"] },
                      "subsumedBy": { "type": "array", "items": { "type": "string" } },
                      "cloneOf": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              },
              "guardRequired": { "const": true }
            }
          }
        },
        "critical": { "type": "integer", "minimum": 0 }
      }
    },
    "audit": {
      "type": "object",
      "required": ["notice", "wrong", "falseTests", "overlap", "combine", "coverage", "speed"],
      "additionalProperties": false,
      "properties": {
        "notice": {
          "const": "A signal, not a verdict: no test is ever advised for removal. Overlap and look-alikes are evidence for a person or agent to read; any change to tests must pass guard. Coverage and caught faults show what ran and what was noticed, never whether an expectation is right."
        },
        "wrong": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["unit", "file", "reasons"],
            "additionalProperties": false,
            "properties": {"unit": {"type": "string"}, "file": {"type": "string"}, "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
          }
        },
        "falseTests": {
          "type": "object",
          "required": ["measured", "units", "unchecked", "timeoutOnly"],
          "additionalProperties": false,
          "properties": {
            "measured": {"type": "boolean"},
            "units": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["unit", "file", "coveredMutants", "kills", "panicKills", "reason"],
                "additionalProperties": false,
                "properties": {
                  "unit": {"type": "string"},
                  "file": {"type": "string"},
                  "coveredMutants": {"type": "integer"},
                  "kills": {"type": "integer"},
                  "panicKills": {"type": "integer"},
                  "reason": {"enum": ["catches-nothing", "catches-only-by-panic"]}
                }
              }
            },
            "unchecked": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "lines", "mutants"],
                "additionalProperties": false,
                "properties": {
                  "source": {"type": "string"},
                  "lines": {"$ref": "#/$defs/lineSet"},
                  "mutants": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "line"],
                      "additionalProperties": false,
                      "properties": {"id": {"type": "string"}, "line": {"type": "integer"}, "description": {"type": "string"}}
                    }
                  }
                }
              }
            },
            "timeoutOnly": {"type": "array", "items": {"type": "string"}}
          }
        },
        "overlap": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["basis", "units", "crossRunner"],
            "additionalProperties": false,
            "properties": {"basis": {"enum": ["kills", "lines"]}, "units": {"type": "array", "items": {"type": "string"}}, "crossRunner": {"type": "boolean"}}
          }
        },
        "combine": {
          "type": "object",
          "required": ["groups", "acrossFiles"],
          "additionalProperties": false,
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["group", "file", "units", "form"],
                "additionalProperties": false,
                "properties": {
                  "group": {"type": "string"},
                  "file": {"type": "string"},
                  "units": {"type": "array", "items": {"type": "string"}},
                  "form": {"enum": ["table-of-cases", "parametrize", "each"]}
                }
              }
            },
            "acrossFiles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["units", "files", "form"],
                "additionalProperties": false,
                "properties": {
                  "units": {"type": "array", "items": {"type": "string"}},
                  "files": {"type": "array", "items": {"type": "string"}},
                  "form": {"const": "shared-helper"}
                }
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "required": ["files", "unmeasured"],
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "critical", "covered", "coverable", "pct", "uncovered"],
                "additionalProperties": false,
                "properties": {
                  "source": {"type": "string"},
                  "critical": {"type": "boolean"},
                  "covered": {"type": "integer"},
                  "coverable": {"type": "integer"},
                  "pct": {"anyOf": [{"type": "number"}, {"type": "null"}]},
                  "uncovered": {"$ref": "#/$defs/lineSet"}
                }
              }
            },
            "unmeasured": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "reason"],
                "additionalProperties": false,
                "properties": {"source": {"type": "string"}, "reason": {"type": "string"}}
              }
            }
          }
        },
        "speed": {
          "type": "object",
          "required": ["slowest", "slowLowValue", "mutationCostMs", "flaky"],
          "additionalProperties": false,
          "properties": {
            "slowest": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["unit", "durationMs"],
                "additionalProperties": false,
                "properties": {"unit": {"type": "string"}, "durationMs": {"type": "integer"}}
              }
            },
            "slowLowValue": {"type": "array", "items": {"type": "string"}},
            "mutationCostMs": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
            "flaky": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "guard": {
      "type": "object",
      "required": ["pass", "checks", "removed", "renamed"],
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "pass"],
            "additionalProperties": false,
            "properties": {
              "id": { "enum": ["head-passes", "coverage-lines", "coverage-ratio", "critical-coverage", "critical-mutation", "critical-removed", "critical-downgraded"] },
              "pass": { "type": "boolean" },
              "lost": { "$ref": "#/$defs/lost" },
              "missing": { "type": "boolean" }, "notCompared": { "const": "runtime-changed" },
              "units": { "type": "array", "items": { "type": "string" } },
              "preexisting": { "type": "array", "items": { "type": "string" } },
              "sources": { "type": "array", "items": { "type": "string" } },
              "base": { "$ref": "#/$defs/coverageRatio" },
              "head": { "$ref": "#/$defs/coverageRatio" }
            }
          }
        },
        "renamed": {
          "type": "array",
          "items": { "type": "object", "required": ["from", "to"], "additionalProperties": false, "properties": { "from": { "type": "string" }, "to": { "type": "string" } } }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "tier", "uniqueLines", "uniqueKills"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "tier": { "$ref": "#/$defs/tier" },
              "uniqueLines": { "type": ["integer", "null"], "minimum": 0 },
              "uniqueKills": { "type": ["integer", "null"], "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "tier": { "enum": ["critical", "standard", "minor"] },
    "advice": { "enum": ["keep", "consolidate", "rewrite", "move-to-check", "none"] },
    "brittleKind": { "enum": ["source-text", "css-class", "doc-wording", "file-snapshot"] },
    "lineSet": { "type": "string", "pattern": "^([1-9][0-9]*(-[1-9][0-9]*)?(,[1-9][0-9]*(-[1-9][0-9]*)?)*)?$" },
    "coverageRatio": {
      "type": "object",
      "required": ["covered", "coverable", "pct"],
      "additionalProperties": false,
      "properties": {
        "covered": { "type": "integer", "minimum": 0 },
        "coverable": { "type": "integer", "minimum": 0 },
        "pct": { "type": ["number", "null"] }
      }
    },
    "mutationScore": {
      "type": "object",
      "required": ["detected", "undetected", "score"],
      "additionalProperties": false,
      "properties": {
        "detected": { "type": "integer", "minimum": 0 },
        "undetected": { "type": "integer", "minimum": 0 },
        "score": { "type": ["number", "null"] }
      }
    },
    "lost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lines": { "type": "object", "additionalProperties": { "$ref": "#/$defs/lineSet" } },
        "mutants": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
