{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cupel.dev/schemas/cupel-spec-1/config.schema.json",
  "title": "Cupel config, cupel.json (cupel-spec/1)",
  "description": "Every key is optional. Defaults are given as `default` and apply when a key is absent.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "builtInto": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "description": "Sources (glob keys) built into an artifact that other tests load, such as Rust crates compiled to a WebAssembly module: uncovered matching sources are reported as unmeasured with the artifact and how many tests loaded it."
    },
    "spec": { "type": "string", "pattern": "^cupel-spec/1(\\.[0-9]+)?$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "type": "array", "items": { "type": "string" }, "default": ["**"] },
        "exclude": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "runners": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "tests": { "type": "string" },
          "collector": { "type": "string", "description": "An external collector command that writes the input format (D13)." },
          "prepare": { "type": "string", "description": "A command run once before collecting, for example a build step." },
          "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Extra environment variables for the test run." },
          "mutants": {
          "type": "object",
          "additionalProperties": false,
          "description": "Cargo: Rust mutation. By default Cupel runs the installed cargo-mutants (D19); backend cupel-rust selects the restricted built-in mutator.",
          "properties": {
            "backend": { "enum": ["cargo-mutants", "cupel", "cupel-rust"], "description": "cargo-mutants (default) runs each fault with cargo-mutants; cupel runs cargo-mutants' faults itself: only the test targets and tests that run the faulty line, fastest first, stopping after two catching targets, with certain faults switched in one build (D21); cupel-rust is the restricted built-in mutator." },
            "schemata": { "type": "boolean", "description": "backend cupel: compile faults the rewriter is certain about into one build, switched by CUPEL_FAULT (default true)." },
            "command": { "type": "string", "minLength": 1, "description": "The cargo-mutants executable; default cargo-mutants on PATH." },
            "jobs": { "type": "integer", "minimum": 1, "description": "Parallel cargo-mutants jobs; default 1." },
            "wholeWorkspace": { "type": "boolean", "description": "Test every workspace package for every fault (--test-workspace=true) instead of only the packages whose tests run the faulty lines; use when features differ between a package alone and the whole workspace." },
            "args": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Extra cargo-mutants arguments, such as --exclude-re." },
            "crossRunner": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sources", "artifact", "build"],
              "description": "Opt-in: re-test Rust survivors in sources built into an artifact with the tests that load it (build step, then those tests, in a scratch copy).",
              "properties": {
                "sources": { "type": "string", "minLength": 1 },
                "artifact": { "type": "string", "minLength": 1 },
                "build": { "type": "string", "minLength": 1 },
                "maxMutants": { "type": "integer", "minimum": 1 },
                "buildTimeoutSeconds": { "type": "integer", "minimum": 1 },
                "testTimeoutSeconds": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "project": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "items": { "type": "string", "minLength": 1 } }], "description": "Vitest: the project name or names to run (passed as --project)." }
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "array", "items": { "type": "string" }, "default": [] },
        "minor": { "type": "array", "items": { "type": "string" }, "default": [] },
        "pathWords": {
          "type": "array", "items": { "type": "string", "minLength": 1 },
          "default": ["auth", "permission", "tenan", "token", "secret", "egress", "billing", "quota", "migrat", "backup", "delet", "public-api", "credential", "crypto", "leak", "unsafe", "sign-in", "login", "security", "isolat", "sandbox", "privacy", "integrity", "redact", "inject", "travers", "harden", "admission", "budget"]
        },
        "titleWords": {
          "type": "array", "items": { "type": "string", "minLength": 1 },
          "default": ["negative", "security", "forged", "tamper", "refuse", "permission", "token", "secret", "credential", "unsafe", "leak"]
        },
        "extraPathWords": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
        "extraTitleWords": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "boolean", "default": true },
        "changedLines": { "type": "boolean", "default": true },
        "targeted": { "type": "boolean", "default": true, "description": "With report --evidence, mutate the own lines of units being reviewed (D5)." },
        "maxMutants": { "type": "integer", "minimum": 1, "default": 200 },
        "maxSeconds": { "type": "integer", "minimum": 1, "default": 300 },
        "seed": { "type": "integer", "default": 20261021 },
        "reuse": {
          "description": "K15: copy fault results of an earlier input whose basis still holds. false switches reuse off; ignore lists project files whose changes never affect test outcomes (for example docs no test reads); env adds environment variables whose values change test outcomes.",
          "default": true,
          "anyOf": [
            { "type": "boolean" },
            { "type": "object", "additionalProperties": false, "properties": { "ignore": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "env": { "type": "array", "items": { "type": "string", "minLength": 1 } } } }
          ]
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage": { "const": "ratchet", "default": "ratchet" },
        "criticalCoverage": {
          "anyOf": [{ "const": "ratchet" }, { "type": "number", "minimum": 0, "maximum": 100 }],
          "default": "ratchet"
        },
        "criticalMutation": { "const": "no-loss", "default": "no-loss" }
      }
    },
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consolidate": { "type": "boolean", "default": true },
        "shapeSimilarity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 },
        "lineJaccard": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.3 },
        "duplicateShape": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.9 },
        "slowMs": { "type": "integer", "minimum": 0, "default": 2000 },
        "lowValueUniqueLines": { "type": "integer", "minimum": 0, "default": 5 },
        "minRuns": { "type": "integer", "minimum": 1, "default": 2 }
      }
    },
    "brittleness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patterns": {
          "type": "array",
          "description": "Extra detector patterns, as data (D13). Collectors apply them; the engine reads only the resulting findings.",
          "items": {
            "type": "object",
            "required": ["kind", "pattern"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["source-text", "css-class", "doc-wording", "file-snapshot"] },
              "language": { "type": "string" },
              "pattern": { "type": "string", "minLength": 1 },
              "deliberate": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
